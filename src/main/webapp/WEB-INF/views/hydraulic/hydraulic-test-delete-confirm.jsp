<%@ page contentType="text/html; charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Elimina prova idraulica</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/style.css?v=13"></head><body><jsp:include page="/WEB-INF/views/includes/navbar.jsp"/><div class="container mt-5"><div class="card-base mx-auto" style="max-width:560px"><h2 class="mb-3">Elimina prova idraulica</h2><p>Vuoi eliminare definitivamente la prova del motore <strong><c:out value="${hydraulicTest.engineCode}"/></strong>?</p><form method="post" action="<%= request.getContextPath() %>/hydraulic-test/delete?id=${hydraulicTest.id}"><input type="hidden" name="csrfToken" value="${sessionScope.csrf_token}"><input type="hidden" name="confirmDelete" value="true"><div class="d-flex gap-2"><a class="btn btn-cancel-action" href="<%= request.getContextPath() %>/hydraulic-test/detail?id=${hydraulicTest.id}">Annulla</a><button class="btn btn-detail-delete">Elimina</button></div></form></div></div></body></html>
